model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "fact_orders", "fact_order_items", "fact_payments", "dim_customers", "dim_products", "dim_sellers", "dim_states", "cohort_retention", "Date", "_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table fact_orders
ref table fact_order_items
ref table fact_payments
ref table dim_customers
ref table dim_products
ref table dim_sellers
ref table dim_states
ref table cohort_retention
ref table Date
ref table _Measures

ref cultureInfo en-US

