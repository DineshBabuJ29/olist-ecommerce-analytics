	partition fact_order_items = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_order_items.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty CSV cells -> null, so numeric columns convert cleanly
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"order_id", type text}, {"order_item_id", Int64.Type}, {"product_id", type text}, {"seller_id", type text}, {"price", type number}, {"freight_value", type number}, {"item_gmv", type number}, {"customer_unique_id", type text}, {"customer_state", type text}, {"purchase_date", type date}, {"order_month", type text}, {"order_month_num", Int64.Type}, {"in_analysis_window", Int64.Type}, {"is_valid", Int64.Type}, {"is_delivered", Int64.Type}, {"is_late", Int64.Type}, {"delivery_days", type number}, {"review_score", Int64.Type}, {"category", type text}}, "en-US")
				in
				    Typed

