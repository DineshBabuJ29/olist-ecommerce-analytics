	partition dim_customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_customers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty CSV cells -> null, so numeric columns convert cleanly
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"customer_unique_id", type text}, {"customer_city", type text}, {"customer_state", type text}, {"first_order_date", type date}, {"last_order_date", type date}, {"cohort_month", type text}, {"cohort_month_num", Int64.Type}, {"total_orders", Int64.Type}, {"total_gmv", type number}, {"customer_type", type text}, {"recency_days", Int64.Type}, {"r_score", Int64.Type}, {"f_score", Int64.Type}, {"m_score", Int64.Type}, {"rfm_code", type text}, {"rfm_segment", type text}}, "en-US")
				in
				    Typed

