	partition fact_orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_orders.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty CSV cells -> null, so numeric columns convert cleanly
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"order_id", type text}, {"order_status", type text}, {"order_purchase_timestamp", type datetime}, {"order_estimated_delivery_date", type datetime}, {"customer_unique_id", type text}, {"customer_city", type text}, {"customer_state", type text}, {"is_valid", Int64.Type}, {"is_delivered", Int64.Type}, {"delivery_days", type number}, {"estimated_days", type number}, {"delay_days", Int64.Type}, {"is_late", Int64.Type}, {"delay_bucket", type text}, {"purchase_date", type date}, {"order_year", Int64.Type}, {"order_month", type text}, {"order_month_num", Int64.Type}, {"purchase_day_num", Int64.Type}, {"order_weekday", type text}, {"order_weekday_num", Int64.Type}, {"order_hour", Int64.Type}, {"in_analysis_window", Int64.Type}, {"items_count", Int64.Type}, {"sellers_count", Int64.Type}, {"product_revenue", type number}, {"freight_value", type number}, {"order_gmv", type number}, {"payment_value", type number}, {"max_installments", Int64.Type}, {"main_payment_type", type text}, {"review_score", Int64.Type}, {"has_comment", Int64.Type}, {"is_first_order", Int64.Type}}, "en-US")
				in
				    Typed

